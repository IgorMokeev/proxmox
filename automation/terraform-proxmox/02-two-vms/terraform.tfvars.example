# =====================================================================
# terraform.tfvars.example — ОБРАЗЕЦ ВАШИХ НАСТРОЕК
# ---------------------------------------------------------------------
#   cp terraform.tfvars.example terraform.tfvars
#   nano terraform.tfvars
# Файл terraform.tfvars содержит токен — не публикуйте его.
# =====================================================================

# --- Proxmox ---
pm_endpoint  = "https://10.1.1.20:8006/"
pm_node      = "archimedes"
pm_api_token = "terraform@pve!tf=ВСТАВЬТЕ-СЕКРЕТ-ТОКЕНА"

# --- Сеть ---
gateway     = "10.1.1.1"
dns_servers = ["10.1.1.1"]

# --- Список ВМ ---
# Имя ВМ (слева) -> параметры. Добавьте/удалите блоки по желанию.
vms = {
  "ubuntu-vm-01" = {
    template_id = 11243 # Ubuntu 24.04
    vm_id       = 5101
    ip          = "10.1.1.81/24"
  }

  "debian-vm-01" = {
    template_id = 10133 # Debian 13
    vm_id       = 5102
    ip          = "10.1.1.82/24"
  }

  # Пример третьей машины (CentOS 10 требует cpu_type = "x86-64-v3"):
  # "centos-vm-01" = {
  #   template_id = 180103
  #   vm_id       = 5103
  #   ip          = "10.1.1.83/24"
  #   cpu_type    = "x86-64-v3"
  # }
}
