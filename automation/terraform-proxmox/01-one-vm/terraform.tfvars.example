# =====================================================================
# terraform.tfvars.example — ОБРАЗЕЦ ВАШИХ НАСТРОЕК
# ---------------------------------------------------------------------
# Как пользоваться:
#   cp terraform.tfvars.example terraform.tfvars
#   nano terraform.tfvars        # поправьте значения под себя
# Всё, что здесь не указано, берётся из default в variables.tf.
# Файл terraform.tfvars содержит токен — не публикуйте его.
# =====================================================================

# --- Proxmox ---
pm_endpoint  = "https://10.1.1.20:8006/"
pm_node      = "archimedes"
pm_api_token = "terraform@pve!tf=ВСТАВЬТЕ-СЕКРЕТ-ТОКЕНА"

# --- Шаблон и ВМ ---
template_id = 11243 # Ubuntu 24.04 (Debian 10133, CentOS 180103)
vm_id       = 5001
vm_name     = "test-vm-01"

# --- Железо ---
cores     = 2
memory_mb = 4096
cpu_type  = "x86-64-v2-AES" # для CentOS 10 поставьте "x86-64-v3"

# --- Сеть (свободный пул 10.1.1.80 - 10.1.1.108) ---
vm_ip       = "10.1.1.80/24"
gateway     = "10.1.1.1"
dns_servers = ["10.1.1.1"]
